{
  "template_id": "tpl_claw_gripper",
  "build_type": "claw_gripper",
  "version": "0.1",
  "title": "Servo gripper (claw)",
  "summary": "Claw template: a robot claw, gripper, servo gripper, end effector, pincer, two-finger claw for a desk or a robot arm, modelled on the gripper end of the SO-101. Rows: one gripper servo (STS3215 bus servo, or a hobby servo), the motor control board, a power supply, a USB-C cable, printed jaw and wrist parts, screws and a table clamp. Detection labels: servo motor, gripper, claw, motor control board, power supply, clamp. The gripper is not sold as its own BOM, so quantities are derived from the arm and the screw counts are assumptions.",
  "references": [
    {
      "url": "https://github.com/TheRobotStudio/SO-ARM100",
      "title": "SO-ARM100 / SO-101 README (TheRobotStudio), the gripper end of the arm",
      "licence": "Apache-2.0",
      "used_for": "servo, board, supply, cable, clamp and print settings; quantities for a gripper alone are derived"
    },
    {
      "url": "https://huggingface.co/docs/lerobot/so101",
      "title": "LeRobot docs: SO-101 assembly",
      "licence": "[unverified]; cited, not copied",
      "used_for": "the gripper is motor ID 6; assembly order of the gripper parts"
    }
  ],
  "questions": [
    {
      "id": "servo_type",
      "text": "Which servo?",
      "chips": [
        {"value": "bus", "label": "Bus servo (STS3215)"},
        {"value": "hobby", "label": "Hobby servo (SG90 or MG996R)"}
      ],
      "default": "bus",
      "skip_if": ["text_mentions_servo"]
    },
    {
      "id": "own_printer",
      "text": "Do you have a 3D printer?",
      "chips": [
        {"value": "yes", "label": "Yes, I'll print the parts"},
        {"value": "no", "label": "No"}
      ],
      "default": "yes",
      "skip_if": ["memory_answers"]
    }
  ],
  "variants": [
    {
      "id": "bus_servo",
      "label": "STS3215 bus servo (SO-101 gripper)",
      "when": {"servo_type": "bus"},
      "overrides": {}
    },
    {
      "id": "hobby_servo",
      "label": "Hobby servo and an Arduino (rule of thumb)",
      "when": {"servo_type": "hobby"},
      "overrides": {
        "servo": {
          "typical_spec": "One SG90 or MG996R hobby servo; the SG90 4.8–6 V range is unverified, no official sheet found (rule of thumb)",
