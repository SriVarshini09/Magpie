          "search_query": "Arduino Uno R3",
          "rules": ["G1", "G11"],
          "basis": "rule_of_thumb",
          "source": null
        },
        "psu": {
          "typical_spec": "Separate 5–6 V supply for the servo, not the board's 5 V pin (rule of thumb)",
          "attrs": {"voltage_range": "5-6", "voltage_v": null, "current_a": null, "connector": null},
          "search_query": "5V 3A power supply for servos",
          "rules": ["G1", "G10"],
          "basis": "rule_of_thumb",
          "source": null
        },
        "usb_cable": {
          "typical_spec": "USB cable whose plug matches the Arduino (rule of thumb)",
