          "search_query": "STS3215 12V C018 servo",
          "source": {"url": "https://github.com/TheRobotStudio/SO-ARM100", "quote": "The 12V version has a stall torque of 30kg.cm"}
        },
        "psu": {
          "typical_spec": "12V 5A+ power supply, 5.5×2.1 mm plug",
          "attrs": {"voltage_v": "12", "current_a": "5", "connector": "barrel 5.5x2.1"},
          "search_query": "12V 5A power supply 5.5x2.1mm",
          "source": {"url": "https://github.com/TheRobotStudio/SO-ARM100", "quote": "12V 5A+ power supply"}
        }
      }
    }
