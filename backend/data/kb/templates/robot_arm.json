{
  "template_id": "tpl_robot_arm",
  "build_type": "robot_arm",
  "version": "0.1",
  "title": "SO-101 follower arm",
  "summary": "Robot arm template: a desktop robot arm, SO-101, SO-ARM100, LeRobot follower arm, 6-axis arm with bus servos, teleoperation arm. Rows: six STS3215 bus servos, the Waveshare bus servo adapter, a 5V or 12V power supply with a 5.5×2.1 mm plug, USB-C data cables, table clamps, a Phillips screwdriver set and the 3D-printed parts. Detection labels: servo motor, robot arm, motor control board, power supply, usb cable, clamp. Used for a text or photo request for an arm with no link; with the SO-ARM100 link the README itself is the source and this template only supplies the view and questions.",
  "references": [
    {
      "url": "https://github.com/TheRobotStudio/SO-ARM100",
      "title": "SO-ARM100 / SO-101 README (TheRobotStudio), parts for one follower arm, read at commit a758567c",
      "licence": "Apache-2.0",
      "used_for": "every row: parts, quantities, the 12V note, print settings; stated total $121.94 per follower arm"
    }
  ],
  "questions": [
    {
      "id": "voltage_class",
      "text": "Which servo voltage?",
      "chips": [
        {"value": "7v4", "label": "7.4V (standard)"},
        {"value": "12v", "label": "12V (more torque)"}
      ],
      "default": "7v4",
      "skip_if": ["text_mentions_voltage"]
    },
    {
      "id": "own_printer",
      "text": "Do you have a 3D printer?",
      "chips": [
        {"value": "yes", "label": "Yes, I'll print the parts"},
        {"value": "no", "label": "No"}
      ],
      "default": "yes",
      "skip_if": ["memory_answers"]
    },
    {
      "id": "own_screwdriver",
      "text": "Have a small Phillips screwdriver set?",
      "chips": [
        {"value": "yes", "label": "Yes"},
        {"value": "no", "label": "No"}
      ],
      "default": "yes",
      "skip_if": ["memory_answers"]
    }
  ],
  "variants": [
    {
      "id": "7v4",
      "label": "7.4V servos on a 5V supply",
      "when": {"voltage_class": "7v4"},
      "overrides": {}
    },
    {
      "id": "12v",
      "label": "12V servos on a 12V 5A+ supply",
      "when": {"voltage_class": "12v"},
      "overrides": {
        "servo": {
          "typical_spec": "STS3215 12V, 30 kg·cm stall torque (C018)",
