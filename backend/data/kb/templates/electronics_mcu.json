    {
      "id": "esp32_devkit",
      "label": "ESP32 DevKitC project (3.3 V)",
      "when": {"board": "esp32"},
      "overrides": {
        "mcu": {
          "typical_spec": "ESP32 DevKitC: 3.3 V logic, GPIO not 5 V tolerant; powered through micro-USB, the 5V pin or the 3V3 pin, only one at a time (rule of thumb here; the Espressif datasheet lines are KB rows in electrical_notes)",
