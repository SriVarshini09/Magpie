{
  "template_id": "tpl_electronics_mcu",
  "build_type": "electronics_mcu",
  "version": "0.1",
  "title": "Microcontroller project",
  "summary": "Electronics template: a microcontroller project, Arduino or ESP32 project, breadboard circuit, sensor project, weather station, e-paper display, IoT gadget, starter kit, blinking LEDs. Rows: microcontroller board (Arduino Uno 5 V or ESP32 3.3 V), USB cable, breadboard, jumper wires, sensor, display, servo or DC motor with a driver, LEDs, resistors, buttons and potentiometers, battery, e-paper adapter. Detection labels for a breadboard photo: arduino board, esp32 board, breadboard, jumper wires, led, resistor, sensor module, servo motor, lcd display, battery. Starting point, not a verified design; kit rows come from a reseller's kit list and are rules of thumb.",
  "references": [
    {
      "url": "https://docs.arduino.cc/resources/datasheets/A000066-datasheet.pdf",
      "title": "Arduino Uno R3 datasheet (A000066)",
      "licence": "[unverified]; cited, short quote",
      "used_for": "mcu row: VIN range and 5 V logic"
    },
    {
      "url": "https://www.kiwi-electronics.com/en/educational-kits-288/arduino-starter-kit-736",
      "title": "Arduino Starter Kit K000007 contents (reseller listing)",
      "licence": "[unverified]; reseller listing, cited, not copied",
      "used_for": "arduino_starter kit rows (rules of thumb); unverified against Arduino's own page, which refused automated requests"
    },
    {
      "url": "https://github.com/lmarzen/esp32-weather-epd",
      "title": "esp32-weather-epd README (lmarzen), parts table, read at commit c78ad15e",
      "licence": "GPL-3.0 (parts list read; no code used)",
      "used_for": "esp32_epaper variant rows: board, panel, adapter, sensor, battery, wires"
    }
  ],
  "questions": [
    {
      "id": "board",
      "text": "Which board?",
      "chips": [
        {"value": "arduino_uno", "label": "Arduino Uno (5 V)"},
        {"value": "esp32", "label": "ESP32 (3.3 V)"}
      ],
      "default": "arduino_uno",
      "skip_if": ["text_mentions_board", "link_names_board"]
    },
    {
      "id": "power",
      "text": "How is it powered?",
      "chips": [
        {"value": "usb", "label": "USB"},
        {"value": "battery", "label": "Battery"},
        {"value": "wall", "label": "Wall adapter"}
      ],
      "default": "usb",
      "skip_if": ["link_names_power"]
    },
    {
      "id": "own_soldering_iron",
      "text": "Have a soldering iron?",
      "chips": [
        {"value": "yes", "label": "Yes"},
        {"value": "no", "label": "No"}
      ],
      "default": "yes",
      "skip_if": ["memory_answers", "photo_present"]
    },
    {
      "id": "own_photo_parts",
      "text": "Are the parts in your photo already yours?",
      "chips": [
        {"value": "yes", "label": "Yes, I have them"},
        {"value": "no", "label": "No"}
      ],
      "default": "yes",
      "skip_if": ["no_photo"]
    }
  ],
  "variants": [
    {
