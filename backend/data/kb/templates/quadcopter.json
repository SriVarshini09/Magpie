{
  "template_id": "tpl_quadcopter",
  "build_type": "quadcopter",
  "version": "0.1",
  "title": "Small camera quadcopter",
  "summary": "Quadcopter template: a small camera drone, quad, quadcopter, FPV drone, multicopter, mini quad, cinewhoop or toothpick; palm-size 3-inch, 5-inch freestyle, or a 10-inch X500 development kit. Rows: frame, brushless motors, ESC (4-in-1 or all-in-one), flight controller, propellers, power distribution, LiPo battery, RC receiver, FPV camera, video transmitter and antenna, GPS, LiPo balance charger, radio transmitter and goggles. Detection labels: drone frame, brushless motor, propeller, flight controller board, ESC board, LiPo battery, FPV camera, antenna, receiver. Starting point, not a verified design: the 3-inch and 5-inch rows are rules of thumb.",
  "references": [
    {
      "url": "https://docs.px4.io/v1.14/en/frames_multicopter/holybro_x500V2_pixhawk5x",
      "title": "PX4 User Guide: Holybro X500 V2 (Pixhawk 5X build)",
      "licence": "CC BY 4.0",
      "used_for": "which parts a quadcopter needs, the PDB and connector layout, and the x500 variant rows; not the 3-inch or 5-inch numbers"
    },
    {
      "url": "https://docs.holybro.com/drone-development-kit/px4-development-kit-x500v2",
      "title": "Holybro PX4 Development Kit X500 V2",
      "licence": "[unverified]; cited, not copied",
      "used_for": "x500 variant: motor KV920 (the PX4 page says KV880; both cited) and the 4S 2000-5000 mAh battery range"
    },
    {
      "url": "https://oscarliang.com/motors/",
      "title": "Oscar Liang: FPV drone motors",
      "licence": "not an open licence; cited, short quote",
      "used_for": "5in variant: motor KV range per cell count (rule of thumb)"
    }
  ],
  "questions": [
    {
      "id": "size_class",
      "text": "What size?",
      "chips": [
        {
          "value": "3in",
          "label": "Palm-size (3-inch)"
        },
        {
          "value": "5in",
          "label": "5-inch"
        },
        {
          "value": "x500",
          "label": "10-inch dev kit"
        }
      ],
      "default": "3in",
      "skip_if": [
        "text_mentions_size"
      ]
    },
    {
      "id": "own_radio",
      "text": "Have a radio and goggles?",
      "chips": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "default": "yes",
      "skip_if": [
        "memory_answers"
      ]
    },
    {
      "id": "own_soldering_iron",
      "text": "Have a soldering iron?",
      "chips": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
      ],
      "default": "yes",
      "skip_if": [
        "memory_answers"
      ]
    }
  ],
