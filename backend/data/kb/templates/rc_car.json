      "id": "brain",
      "text": "What drives it?",
      "chips": [
        {"value": "pi5", "label": "Raspberry Pi 5 (self-driving)"},
        {"value": "arduino", "label": "Arduino, no camera"},
        {"value": "none", "label": "None, plain RC"}
