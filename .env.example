# Build-to-Cart environment (PLAN §3.3). Copy to .env at the repo root. Never commit .env.
# One file serves both apps: the backend loads it; Vite reads only the VITE_* names.
# Mock mode needs no keys at all.

# --- mode -------------------------------------------------------------------
# mock | live | record | replay.  mock = fixtures only, no network (the scaffold default; PLAN's default is live)
DEMO_MODE=mock
# Per-service override, mock | live. Services: ANTHROPIC AIRBYTE_GITHUB SINGLESTORE SIE COGNEE AMPLITUDE STATSIG
# KEENABLE EXA_AIRBYTE GITHUB_SEARCH STRIPE SHOPIFY_UCP SERPAPI ADAFRUIT MAGENTO DIGIKEY CARTLINKS
# IMPL_SERPAPI=mock
PINNED_NOW=2026-11-20T13:00:00-08:00
# Approve is blocked when the oldest cart price is older (PLAN §12.3)
PRICE_MAX_AGE_MIN=15
# The Vite dev server; 5175 is where it moves when 5173 is taken
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
# Mock mode: pause between SSE fixture events
MOCK_SSE_DELAY_MS=250

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_FAST=claude-sonnet-5-5
MODEL_PLAN=claude-opus-5-5
# The intake call (text + images)
MODEL_VISION=claude-sonnet-5-5

# --- shopping prices --------------------------------------------------------
# REQUIRED for live runs. Never logged; stripped from evidence files
SERPAPI_KEY=
# Hard stop for the day (free plan: 250/month, 50/hour)
SERPAPI_MAX_SEARCHES=150
# Optional extra engines besides google_shopping and amazon, comma-separated (each costs one search per line)
SERPAPI_ENGINES=
# Refuse uncached searches past this many in an hour (free plan: 50)
SERPAPI_MAX_PER_HOUR=45
# Optional backup for Google Shopping
SERPER_API_KEY=
# Optional (P11). Production app, not sandbox
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Resolve with shutil.which; on Windows it is ucp.cmd
UCP_BIN=ucp
# 0 turns off the `npx` fallback when the ucp CLI is not installed
UCP_NPX_FALLBACK=1
# 0 turns off the per-store catalog search (global search only)
UCP_PER_STORE=1
# Seconds before one ucp CLI call is abandoned
UCP_TIMEOUT_S=60
# Stores whose prefilled cart link a human opened and checked, comma-separated (e.g. amazon). Empty = product links
CART_LINKS_VERIFIED=
# Where the record/replay cache lives (default backend/cache)
B2C_CACHE_DIR=

# --- uploads ----------------------------------------------------------------
UPLOAD_MAX_MB=5
UPLOAD_MAX_EDGE_PX=1024
UPLOAD_MAX_IMAGES=2

# --- reference-design search (P19) ------------------------------------------
# Order; a provider with no key is skipped
REFERENCE_PROVIDERS=keenable,exa_airbyte,claude_web_search,github_search
# Per run
REFERENCE_MAX_SEARCHES=3
REFERENCE_MAX_PAGES=2
# Optional. Reference-design search and page text. Never logged
KEENABLE_API_KEY=
# bearer | x-api-key, and the endpoints (defaults are in integrations/keenable.py)
KEENABLE_AUTH=bearer
KEENABLE_SEARCH_URL=
KEENABLE_FETCH_URL=
# Optional. Used only through the Airbyte `exa` connector
EXA_API_KEY=
# Page text kept per Exa result
EXA_MAX_CHARACTERS=20000
# Optional (stretch 11). TRELLIS.2 Space through gradio_client
HF_TOKEN=

# --- SingleStore ------------------------------------------------------------
# user:password@host:3306/db  (SingleStore Shared)
S2_URL=
# With no S2_URL the same tables live in SQLite at this path (default backend/runs/b2c.sqlite)
B2C_SQLITE_PATH=
# Must equal the SIE embedding model's dimension [confirm in C12]
EMBED_DIM=1024

# --- Superlinked SIE --------------------------------------------------------
# Base URL from the console; key sk-sie-...
SIE_BASE_URL=
SIE_API_KEY=
SIE_EMBED_MODEL=
SIE_RERANK_MODEL=
SIE_EXTRACT_MODEL=
SIE_DETECT_MODEL=IDEA-Research/grounding-dino-base
# xywh | xyxy, from check C25
SIE_BOX_FORMAT=xywh

# --- Airbyte ----------------------------------------------------------------
# Fine-grained PAT, public repos, read-only
AIRBYTE_GITHUB_TOKEN=

# --- Amplitude, Statsig -----------------------------------------------------
AMPLITUDE_AI_API_KEY=
# Optional
STATSIG_SERVER_SECRET=

# --- Cognee -----------------------------------------------------------------
# cloud | local | off
COGNEE_MODE=cloud
# https://<tenant>.aws.cognee.ai
COGNEE_URL=
COGNEE_API_KEY=
# Cognee local mode only. Set BOTH llm and embedding or it defaults to OpenAI (R1 §3c):
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/claude-sonnet-5
LLM_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
TELEMETRY_DISABLED=true

# --- Stripe: TEST MODE ONLY (Tier 2) ----------------------------------------
# MUST start with sk_test_. The backend refuses to start otherwise
STRIPE_SECRET_KEY=
# MUST start with pk_test_
VITE_STRIPE_PUBLISHABLE_KEY=
# ich_... from the sandbox
STRIPE_CARDHOLDER_ID=
# 1 | 2
PAY_TIER=1
# Optional (stretch 5)
PERSONA_SANDBOX_KEY=

# --- mandate signing --------------------------------------------------------
# Generated at first start; git-ignored
MANDATE_KEY_PATH=runs/demo_es256.pem

# --- frontend ---------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
# true for the public build (PLAN §11.9)
VITE_STATIC_REPLAY=false
# Optional: the public repository link in the footer
VITE_REPO_URL=
