# Pipeline mode: the real pipeline on mock services. No keys. The only network use is reading public GitHub READMEs. Copy to .env, or run
#   powershell -ExecutionPolicy Bypass -File scripts\dev-pipeline.ps1      (bash scripts/dev-pipeline.sh)
# Real: intake (keyword router), the scripted agent and its tools, provenance, compatibility rules, the optimizer,
# the mandate guard, the Universal Cart, signing, the hash chain, Verify. SingleStore is its SQLite fallback.
# Mock (labelled simulated; the UI shows "Mock stores"): stores, cart links, reference search, SIE, Cognee, Amplitude,
# Statsig, Stripe.
# GitHub: public READMEs are read for real with no token (api.github.com + raw.githubusercontent.com only, 60 requests
# an hour). Set IMPL_AIRBYTE_GITHUB=mock for the offline profile (bundled SO-ARM100 README only, no network).
DEMO_MODE=live
# Live classes that need no key: no Anthropic key -> keyword router + scripted agent; no S2_URL -> SQLite;
# no AIRBYTE_GITHUB_TOKEN -> the GitHub source's keyless raw fetch
IMPL_ANTHROPIC=live
IMPL_SINGLESTORE=live
IMPL_AIRBYTE_GITHUB=live
# keyless read refused (60 an hour) or offline: the SO-ARM100 link uses its bundled README, labelled simulated
B2C_GITHUB_BUNDLED_FALLBACK=1
ANTHROPIC_API_KEY=
AIRBYTE_GITHUB_TOKEN=
S2_URL=
B2C_SQLITE_PATH=runs/pipeline.sqlite
# Everything else is its mock
IMPL_SIE=mock
IMPL_COGNEE=mock
IMPL_AMPLITUDE=mock
IMPL_STATSIG=mock
IMPL_KEENABLE=mock
IMPL_EXA_AIRBYTE=mock
IMPL_GITHUB_SEARCH=mock
IMPL_STRIPE=mock
IMPL_SHOPIFY_UCP=mock
IMPL_SERPAPI=mock
IMPL_ADAFRUIT=mock
IMPL_MAGENTO=mock
IMPL_DIGIKEY=mock
IMPL_CARTLINKS=mock
# Frontend
VITE_API_BASE=http://localhost:8000
